#include <windows.h>
#include "@CMAKE_SOURCE_DIR@/engine/include/stellar/engine/windows_resource_ids.h"
STELLAR_APPLICATION_ICON_ID ICON "@CMAKE_SOURCE_DIR@/assets/visual/branding/stellar-continuum-v1.ico"
1 VERSIONINFO
 FILEVERSION @STELLAR_GAME_RESOURCE_VERSION@
 PRODUCTVERSION @STELLAR_GAME_RESOURCE_VERSION@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Stellar Continuum - Native C++ Galaxy Preview\0"
   VALUE "FileVersion", "@STELLAR_GAME_NUMERIC_VERSION@\0"
   VALUE "InternalName", "stellar-continuum-native\0"
   VALUE "OriginalFilename", "stellar-continuum-native.exe\0"
   VALUE "ProductName", "Stellar Continuum\0"
   VALUE "ProductVersion", "@STELLAR_GAME_VERSION@\0"
   VALUE "Comments", "Incomplete graphical migration; source @STELLAR_SOURCE_COMMIT@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
