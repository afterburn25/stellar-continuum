# Only the native graphical client packages these approved leader portraits.
file(READ "${CMAKE_SOURCE_DIR}/export/native-leader-art-assets.json" STELLAR_LEADER_ART_ASSETS)
string(JSON STELLAR_LEADER_ART_SCHEMA GET "${STELLAR_LEADER_ART_ASSETS}" schemaVersion)
string(JSON STELLAR_LEADER_ART_COUNT LENGTH "${STELLAR_LEADER_ART_ASSETS}" assets)
if(NOT STELLAR_LEADER_ART_SCHEMA EQUAL 1 OR NOT STELLAR_LEADER_ART_COUNT EQUAL 4)
  message(FATAL_ERROR "Unsupported native leader art asset declaration")
endif()
add_custom_target(stellar_native_leader_art_assets)
foreach(STELLAR_LEADER_ART_KEY IN ITEMS chief-scientist fleet-commander planetary-governor credits)
  if(STELLAR_LEADER_ART_KEY STREQUAL "credits")
    set(STELLAR_LEADER_ART_EXPECTED_SOURCE "docs/engine/NATIVE_LEADER_ART_SOURCES.md")
    set(STELLAR_LEADER_ART_EXPECTED_RUNTIME "Licenses/Leader-art-sources.md")
  else()
    set(STELLAR_LEADER_ART_EXPECTED_SOURCE "assets/visual/leaders/${STELLAR_LEADER_ART_KEY}.jpg")
    set(STELLAR_LEADER_ART_EXPECTED_RUNTIME "${STELLAR_LEADER_ART_EXPECTED_SOURCE}")
  endif()
  string(JSON STELLAR_LEADER_ART_SOURCE GET "${STELLAR_LEADER_ART_ASSETS}" assets ${STELLAR_LEADER_ART_KEY} source)
  string(JSON STELLAR_LEADER_ART_RUNTIME GET "${STELLAR_LEADER_ART_ASSETS}" assets ${STELLAR_LEADER_ART_KEY} runtimePath)
  string(JSON STELLAR_LEADER_ART_EXPECTED_HASH GET "${STELLAR_LEADER_ART_ASSETS}" assets ${STELLAR_LEADER_ART_KEY} sha256)
  if(NOT STELLAR_LEADER_ART_SOURCE STREQUAL STELLAR_LEADER_ART_EXPECTED_SOURCE OR
     NOT STELLAR_LEADER_ART_RUNTIME STREQUAL STELLAR_LEADER_ART_EXPECTED_RUNTIME)
    message(FATAL_ERROR "Unreviewed native leader art ${STELLAR_LEADER_ART_KEY} path")
  endif()
  file(SHA256 "${CMAKE_SOURCE_DIR}/${STELLAR_LEADER_ART_SOURCE}" STELLAR_LEADER_ART_ACTUAL_HASH)
  if(NOT STELLAR_LEADER_ART_ACTUAL_HASH STREQUAL STELLAR_LEADER_ART_EXPECTED_HASH)
    message(FATAL_ERROR "Native leader art ${STELLAR_LEADER_ART_KEY} differs from reviewed content")
  endif()
  get_filename_component(STELLAR_LEADER_ART_DESTINATION "${CMAKE_BINARY_DIR}/${STELLAR_LEADER_ART_RUNTIME}" DIRECTORY)
  add_custom_command(TARGET stellar_native_leader_art_assets POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E make_directory "${STELLAR_LEADER_ART_DESTINATION}"
    COMMAND ${CMAKE_COMMAND} -E copy_if_different
      "${CMAKE_SOURCE_DIR}/${STELLAR_LEADER_ART_SOURCE}" "${CMAKE_BINARY_DIR}/${STELLAR_LEADER_ART_RUNTIME}")
endforeach()
