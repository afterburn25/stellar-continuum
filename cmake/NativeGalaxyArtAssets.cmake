# Only the native graphical client packages these approved original images.
# A changed declaration must refresh copy commands in existing build trees too.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${CMAKE_SOURCE_DIR}/export/native-galaxy-art-assets.json")
file(READ "${CMAKE_SOURCE_DIR}/export/native-galaxy-art-assets.json" STELLAR_GALAXY_ART_ASSETS)
string(JSON STELLAR_GALAXY_ART_SCHEMA GET "${STELLAR_GALAXY_ART_ASSETS}" schemaVersion)
string(JSON STELLAR_GALAXY_ART_COUNT LENGTH "${STELLAR_GALAXY_ART_ASSETS}" assets)
if(NOT STELLAR_GALAXY_ART_SCHEMA EQUAL 1 OR NOT STELLAR_GALAXY_ART_COUNT EQUAL 20)
  message(FATAL_ERROR "Unsupported native galaxy art asset declaration")
endif()
add_custom_target(stellar_native_galaxy_art_assets)
math(EXPR STELLAR_GALAXY_ART_LAST "${STELLAR_GALAXY_ART_COUNT}-1")
foreach(STELLAR_GALAXY_ART_INDEX RANGE ${STELLAR_GALAXY_ART_LAST})
  string(JSON STELLAR_GALAXY_ART_KEY MEMBER "${STELLAR_GALAXY_ART_ASSETS}" assets ${STELLAR_GALAXY_ART_INDEX})
  if(STELLAR_GALAXY_ART_KEY STREQUAL "credits")
    set(STELLAR_GALAXY_ART_EXPECTED_SOURCE "docs/engine/NATIVE_GALAXY_ART_SOURCES.md")
    set(STELLAR_GALAXY_ART_EXPECTED_RUNTIME "Licenses/Galaxy-art-sources.md")
  elseif(STELLAR_GALAXY_ART_KEY MATCHES "^(spiral|barred_spiral|elliptical|lenticular|irregular|ring)-generic-(stars_included|gas_dust_only)$")
    set(STELLAR_GALAXY_ART_EXPECTED_SOURCE "assets/visual/galaxies/${STELLAR_GALAXY_ART_KEY}.png")
    set(STELLAR_GALAXY_ART_EXPECTED_RUNTIME "${STELLAR_GALAXY_ART_EXPECTED_SOURCE}")
  else()
    set(STELLAR_GALAXY_ART_EXPECTED_SOURCE "assets/visual/space/${STELLAR_GALAXY_ART_KEY}.png")
    set(STELLAR_GALAXY_ART_EXPECTED_RUNTIME "${STELLAR_GALAXY_ART_EXPECTED_SOURCE}")
  endif()
  string(JSON STELLAR_GALAXY_ART_SOURCE GET "${STELLAR_GALAXY_ART_ASSETS}" assets ${STELLAR_GALAXY_ART_KEY} source)
  string(JSON STELLAR_GALAXY_ART_RUNTIME GET "${STELLAR_GALAXY_ART_ASSETS}" assets ${STELLAR_GALAXY_ART_KEY} runtimePath)
  string(JSON STELLAR_GALAXY_ART_EXPECTED_HASH GET "${STELLAR_GALAXY_ART_ASSETS}" assets ${STELLAR_GALAXY_ART_KEY} sha256)
  if(NOT STELLAR_GALAXY_ART_SOURCE STREQUAL STELLAR_GALAXY_ART_EXPECTED_SOURCE OR
     NOT STELLAR_GALAXY_ART_RUNTIME STREQUAL STELLAR_GALAXY_ART_EXPECTED_RUNTIME)
    message(FATAL_ERROR "Unreviewed native galaxy art ${STELLAR_GALAXY_ART_KEY} path")
  endif()
  file(SHA256 "${CMAKE_SOURCE_DIR}/${STELLAR_GALAXY_ART_SOURCE}" STELLAR_GALAXY_ART_ACTUAL_HASH)
  if(NOT STELLAR_GALAXY_ART_ACTUAL_HASH STREQUAL STELLAR_GALAXY_ART_EXPECTED_HASH)
    message(FATAL_ERROR "Native galaxy art ${STELLAR_GALAXY_ART_KEY} differs from reviewed content")
  endif()
  get_filename_component(STELLAR_GALAXY_ART_DESTINATION "${CMAKE_BINARY_DIR}/${STELLAR_GALAXY_ART_RUNTIME}" DIRECTORY)
  add_custom_command(TARGET stellar_native_galaxy_art_assets POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E make_directory "${STELLAR_GALAXY_ART_DESTINATION}"
    COMMAND ${CMAKE_COMMAND} -E copy_if_different
      "${CMAKE_SOURCE_DIR}/${STELLAR_GALAXY_ART_SOURCE}" "${CMAKE_BINARY_DIR}/${STELLAR_GALAXY_ART_RUNTIME}")
endforeach()
