# Only the native graphical client packages these approved original images.
file(READ "${CMAKE_SOURCE_DIR}/export/native-celestial-assets.json" STELLAR_CELESTIAL_ASSETS)
string(JSON STELLAR_CELESTIAL_SCHEMA GET "${STELLAR_CELESTIAL_ASSETS}" schemaVersion)
string(JSON STELLAR_CELESTIAL_COUNT LENGTH "${STELLAR_CELESTIAL_ASSETS}" assets)
if(NOT STELLAR_CELESTIAL_SCHEMA EQUAL 1 OR NOT STELLAR_CELESTIAL_COUNT EQUAL 10)
  message(FATAL_ERROR "Unsupported native celestial asset declaration")
endif()
add_custom_target(stellar_native_celestial_assets)
foreach(STELLAR_BODY_KEY IN ITEMS mercury venus earth mars jupiter saturn uranus neptune moon credits)
  if(STELLAR_BODY_KEY STREQUAL "credits")
    set(STELLAR_CELESTIAL_EXPECTED_SOURCE "docs/SOL_VISUAL_SOURCES.md")
    set(STELLAR_CELESTIAL_EXPECTED_RUNTIME "Licenses/Sol-visual-sources.md")
  else()
    set(STELLAR_CELESTIAL_EXPECTED_SOURCE "assets/visual/sol/${STELLAR_BODY_KEY}.jpg")
    set(STELLAR_CELESTIAL_EXPECTED_RUNTIME "${STELLAR_CELESTIAL_EXPECTED_SOURCE}")
  endif()
  string(JSON STELLAR_CELESTIAL_SOURCE GET "${STELLAR_CELESTIAL_ASSETS}" assets ${STELLAR_BODY_KEY} source)
  string(JSON STELLAR_CELESTIAL_RUNTIME GET "${STELLAR_CELESTIAL_ASSETS}" assets ${STELLAR_BODY_KEY} runtimePath)
  string(JSON STELLAR_CELESTIAL_EXPECTED_HASH GET "${STELLAR_CELESTIAL_ASSETS}" assets ${STELLAR_BODY_KEY} sha256)
  if(NOT STELLAR_CELESTIAL_SOURCE STREQUAL STELLAR_CELESTIAL_EXPECTED_SOURCE OR
     NOT STELLAR_CELESTIAL_RUNTIME STREQUAL STELLAR_CELESTIAL_EXPECTED_RUNTIME)
    message(FATAL_ERROR "Unreviewed native celestial ${STELLAR_BODY_KEY} path")
  endif()
  file(SHA256 "${CMAKE_SOURCE_DIR}/${STELLAR_CELESTIAL_SOURCE}" STELLAR_CELESTIAL_ACTUAL_HASH)
  if(NOT STELLAR_CELESTIAL_ACTUAL_HASH STREQUAL STELLAR_CELESTIAL_EXPECTED_HASH)
    message(FATAL_ERROR "Native celestial ${STELLAR_BODY_KEY} differs from reviewed content")
  endif()
  get_filename_component(STELLAR_CELESTIAL_DESTINATION "${CMAKE_BINARY_DIR}/${STELLAR_CELESTIAL_RUNTIME}" DIRECTORY)
  add_custom_command(TARGET stellar_native_celestial_assets POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E make_directory "${STELLAR_CELESTIAL_DESTINATION}"
    COMMAND ${CMAKE_COMMAND} -E copy_if_different
      "${CMAKE_SOURCE_DIR}/${STELLAR_CELESTIAL_SOURCE}" "${CMAKE_BINARY_DIR}/${STELLAR_CELESTIAL_RUNTIME}")
endforeach()
